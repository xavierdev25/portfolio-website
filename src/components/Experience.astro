---
import Skills from "./ui/Skills.astro";
---

<section class="flex items-start justify-center gap-24">
  <Skills />
  <div class="flex flex-col">
    <div class="relative w-[480px] h-[740px]">
      <svg
        class="absolute inset-0"
        xmlns="http://www.w3.org/2000/svg"
        width="488"
        height="756"
        viewBox="0 0 488 756"
        fill="none"
        ><rect x="1.5" y="1.5" width="485" height="753" rx="21.5" fill="#480762"></rect><rect
          x="1.5"
          y="1.5"
          width="485"
          height="753"
          rx="21.5"
          stroke="#fff"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-dasharray="16 16"></rect></svg
      >
      <div class="space-y-12 relative z-10 p-9 w-full h-full">
        <div>
          <h2 class="font-anton text-white text-5xl">Educación:</h2>
          <div class="flex mt-4 gap-2">
            <img src="/icons/star.svg" class="w-auto h-7 mt-1" alt="" />
            <div class="text-white flex flex-col">
              <p class="font-anton text-[#A216D9] text-3xl">2022 - Presente</p>
              <div class="flex flex-col -space-y-2">
                <span class="font-black text-2xl">Universidad César Vallejo</span>
                <label class="font-light text-xl">Ingeniería de Sistemas</label>
              </div>
            </div>
          </div>
        </div>
        <div>
          <h2 class="font-anton text-white text-5xl">Experiencia:</h2>
          <div class="flex mt-4 gap-2">
            <img src="/icons/star.svg" class="w-auto h-7 mt-1" alt="" />
            <div class="text-white flex flex-col">
              <p class="font-anton text-[#A216D9] text-3xl">Junior 2025 - Septiembre 2025</p>
              <div class="flex flex-col -space-y-2">
                <span class="font-black text-2xl">GeekCorp EIRL</span>
                <label class="font-light text-xl">Desarrollador Frontend</label>
              </div>
            </div>
          </div>
          <div class="flex mt-4 gap-2">
            <img src="/icons/star.svg" class="w-auto h-7 mt-1" alt="" />
            <div class="text-white flex flex-col">
              <p class="font-anton text-[#A216D9] text-3xl">Junior 2025 - Agosto 2025</p>
              <div class="flex flex-col -space-y-2">
                <span class="font-black text-2xl">GuimarBot</span>
                <label class="font-light text-xl">Desarrollador Fullstack</label>
              </div>
            </div>
          </div>
        </div>
        <div>
          <h2 class="font-anton text-white text-5xl">Certificación:</h2>
          <div class="flex mt-4 gap-2">
            <img src="/icons/star.svg" class="w-auto h-7 mt-1" alt="" />
            <div class="text-white flex flex-col">
              <p class="font-anton text-[#A216D9] text-3xl">2024</p>
              <span class="font-black text-xl">- Ciberseguridad: Ethical Hacking</span>
              <span class="font-black text-xl">- Asistente de Help Desk</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-12">
      <h2 class="font-anton text-4xl text-white">Experiencia de Software:</h2>
      <div class="grid grid-cols-5 gap-7 mt-4">
        <img src="/software/vscode.svg" alt="Visual Studio Code Logo" />
        <img src="/software/figma.svg" alt="Figma Logo" />
        <img src="/software/premiere.svg" alt="Premiere Pro Logo" />
        <img src="/software/photoshop.svg" alt="Photoshop Logo" />
        <img src="/software/illustrator.svg" alt="Illustrator Logo" />
        <img src="/software/aftereffects.svg" alt="After Effects Logo" />
        <img src="/software/blender.svg" alt="Blender Logo" />
      </div>
    </div>
  </div>
</section>
