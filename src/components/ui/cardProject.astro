---
import type { Project } from "../../types/project";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div
  class="bg-white rounded-[15px] sm:rounded-[18px] md:rounded-[20px] p-3 sm:p-4 md:p-4.5 items-stretch space-y-3 sm:space-y-4"
>
  <div class="flex gap-1.5 sm:gap-2">
    <div class="rounded-full p-1.5 sm:p-2 bg-[#D9D9D9]"></div>
    <div class="rounded-full p-1.5 sm:p-2 bg-[#D9D9D9]"></div>
    <div class="rounded-full p-1.5 sm:p-2 bg-[#D9D9D9]"></div>
  </div>
  <div
    class="h-[160px] sm:h-[180px] md:h-[200px] lg:h-[220px] rectangle rounded-[12px] sm:rounded-[15px] md:rounded-[20px] flex items-center justify-center mx-auto bg-gray-100"
  >
    {
      project.images[0] && (
        <img
          src={project.images[0]}
          alt={project.title}
          class="w-full h-full object-cover rounded-[8px] sm:rounded-[10px]"
        />
      )
    }
  </div>
  <div class="flex flex-col leading-5 sm:leading-6 md:leading-7 text-[#0B0705]">
    <span class="text-[18px] sm:text-[20px] md:text-[22px] lg:text-[24px] font-medium"
      >{project.title}</span
    >
    <span class="font-light text-[14px] sm:text-[15px] md:text-[16px] lg:text-[18px] opacity-50"
      >{project.category}</span
    >
  </div>
  <button
    class="ver-mas-btn w-full bg-[#E75DEE] hover:bg-[#d14dd9] text-white font-medium py-1.5 sm:py-2 px-3 sm:px-4 rounded-lg transition-colors duration-200 text-sm sm:text-base"
    data-project-id={project.id}
  >
    Ver más
  </button>
</div>

<style>
  .rectangle {
    border: 0.5px solid #afafaf;
  }
</style>
