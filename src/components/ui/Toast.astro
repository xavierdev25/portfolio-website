---

---

<div
  id="toast-container"
  class="toast-container"
  style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 12px; pointer-events: none;"
>
</div>

<style is:global>
  .toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: none;
  }

  .toast {
    min-width: 300px;
    max-width: 500px;
    padding: 16px 20px;
    border-radius: 12px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    animation: slideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: auto;
    backdrop-filter: blur(10px);
  }

  .toast.removing {
    animation: slideOut 0.3s ease-in-out forwards;
  }

  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes slideOut {
    from {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
    to {
      transform: translateX(400px) scale(0.8);
      opacity: 0;
    }
  }

  .toast-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  .toast-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .toast-title {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.2;
  }

  .toast-message {
    font-size: 14px;
    line-height: 1.4;
    opacity: 0.9;
  }

  .toast-close {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s;
    padding: 0;
  }

  .toast-close:hover {
    opacity: 1;
  }

  .toast-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 0 0 12px 12px;
    animation: progress 5s linear forwards;
  }

  @keyframes progress {
    from {
      width: 100%;
    }
    to {
      width: 0%;
    }
  }

  /* Toast Types */
  .toast.success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
  }

  .toast.error {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: white;
  }

  .toast.warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
  }

  .toast.info {
    background: linear-gradient(135deg, #e75dee 0%, #c93dd1 100%);
    color: white;
  }

  @media (max-width: 640px) {
    .toast-container {
      left: 20px;
      right: 20px;
    }

    .toast {
      min-width: auto;
      max-width: 100%;
    }
  }
</style>

<script>
  type ToastType = "success" | "error" | "warning" | "info";

  interface ToastOptions {
    type?: ToastType;
    title?: string;
    message: string;
    duration?: number;
  }

  const icons = {
    success: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`,
    error: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`,
    warning: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>`,
    info: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`,
  };

  const defaultTitles = {
    success: "¡Éxito!",
    error: "Error",
    warning: "Advertencia",
    info: "Información",
  };

  function showToast(options: ToastOptions) {
    const container = document.getElementById("toast-container");
    if (!container) return;

    const type = options.type || "info";
    const title = options.title || defaultTitles[type];
    const duration = options.duration || 5000;

    const toast = document.createElement("div");
    toast.className = `toast ${type}`;

    // Asegurar estilos base con inline styles como fallback
    const baseStyles = `
      position: relative;
      min-width: 300px;
      max-width: 500px;
      padding: 16px 20px;
      border-radius: 12px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
      color: white;
      font-family: "Urbanist", ui-sans-serif, system-ui, sans-serif;
    `;

    const typeColors = {
      success: "background: linear-gradient(135deg, #10b981 0%, #059669 100%);",
      error: "background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);",
      warning: "background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);",
      info: "background: linear-gradient(135deg, #e75dee 0%, #c93dd1 100%);",
    };

    toast.style.cssText = baseStyles + typeColors[type];

    toast.innerHTML = `
      <div class="toast-icon" style="flex-shrink: 0; width: 24px; height: 24px;">${icons[type]}</div>
      <div class="toast-content" style="flex: 1; display: flex; flex-direction: column; gap: 4px;">
        <div class="toast-title" style="font-weight: 700; font-size: 16px; line-height: 1.2;">${title}</div>
        <div class="toast-message" style="font-size: 14px; line-height: 1.4; opacity: 0.9;">${options.message}</div>
      </div>
      <button class="toast-close" style="flex-shrink: 0; width: 20px; height: 20px; background: transparent; border: none; cursor: pointer; opacity: 0.6; padding: 0; display: flex; align-items: center; justify-content: center;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width: 100%; height: 100%;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="toast-progress" style="position: absolute; bottom: 0; left: 0; height: 3px; background: rgba(255, 255, 255, 0.3); border-radius: 0 0 12px 12px; animation: progress ${duration}ms linear forwards;"></div>
    `;

    container.appendChild(toast);

    // Agregar animación de entrada
    setTimeout(() => {
      toast.style.animation = "slideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards";
    }, 10);

    // Close button
    const closeBtn = toast.querySelector(".toast-close");
    closeBtn?.addEventListener("click", () => removeToast(toast));
    closeBtn?.addEventListener("mouseenter", () => {
      (closeBtn as HTMLElement).style.opacity = "1";
    });
    closeBtn?.addEventListener("mouseleave", () => {
      (closeBtn as HTMLElement).style.opacity = "0.6";
    });

    // Auto remove
    setTimeout(() => {
      removeToast(toast);
    }, duration);
  }

  function removeToast(toast: HTMLElement) {
    toast.style.animation = "slideOut 0.3s ease-in-out forwards";
    setTimeout(() => {
      toast.remove();
    }, 300);
  }

  // Exportar la función globalmente
  (window as any).showToast = showToast;
</script>
